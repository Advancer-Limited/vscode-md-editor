{
  "name": "vscode-md-editor",
  "displayName": "MD Editor & Office Viewer: Markdown, Word, Excel, PDF",
  "description": "Edit Markdown, view and edit Word and Excel files, and read PDFs in VS Code, with Mermaid diagrams, wikilinks, a link graph and grammar checking.",
  "version": "1.5.0",
  "license": "MIT",
  "author": {
    "name": "Advancer Limited",
    "url": "https://github.com/Advancer-Limited"
  },
  "publisher": "advancer-limited",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Advancer-Limited/vscode-md-editor.git"
  },
  "homepage": "https://github.com/Advancer-Limited/vscode-md-editor#readme",
  "bugs": {
    "url": "https://github.com/Advancer-Limited/vscode-md-editor/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdown",
    "markdown editor",
    "wysiwyg",
    "mermaid",
    "wikilinks",
    "word",
    "docx",
    "docx editor",
    "excel",
    "xlsx",
    "xlsx editor",
    "spreadsheet",
    "office",
    "office editing",
    "office viewer",
    "pdf",
    "pdf viewer",
    "document viewer",
    "preview",
    "gltf",
    "grammar",
    "languagetool",
    "diagram",
    "obsidian",
    "backlinks",
    "knowledge graph",
    "word editor",
    "excel editor",
    "3d viewer"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscodeMdEditorSidebar",
          "title": "MD & MMD Editor",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "vscodeMdEditorSidebar": [
        {
          "id": "vscodeMdEditor.graph",
          "name": "MD & MMD Editor",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "vscodeMdEditor.editor",
        "displayName": "VS Code MD Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vscodeMdEditor.mermaid",
        "displayName": "Mermaid Diagram Editor",
        "selector": [
          {
            "filenamePattern": "*.mmd"
          },
          {
            "filenamePattern": "*.mermaid"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vscodeMdEditor.gltf",
        "displayName": "glTF 3D Editor",
        "selector": [
          {
            "filenamePattern": "*.gltf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vscodeMdEditor.docx",
        "displayName": "Word Document Editor",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vscodeMdEditor.xlsx",
        "displayName": "Excel Workbook Editor",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vscodeMdEditor.pdf",
        "displayName": "PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "vscodeMdEditor.chooseDocumentEditors",
        "title": "Choose Editors for Office and PDF Files…",
        "category": "Markdown Editor"
      },
      {
        "command": "vscodeMdEditor.openWithEditor",
        "title": "Open with VS Code MD Editor",
        "category": "Markdown Editor"
      },
      {
        "command": "vscodeMdEditor.checkGrammar",
        "title": "Check Grammar with LanguageTool",
        "category": "Markdown Editor"
      },
      {
        "command": "vscodeMdEditor.setAsDefault",
        "title": "Set VS Code MD Editor as Default for .md and .markdown Files",
        "category": "Markdown Editor"
      },
      {
        "command": "vscodeMdEditor.showGraph",
        "title": "Show Link Graph",
        "category": "Markdown Editor"
      },
      {
        "command": "vscodeMdEditor.toggleGraphMode",
        "title": "Toggle Graph Mode (Local/Global)",
        "category": "Markdown Editor"
      },
      {
        "command": "vscodeMdEditor.openFullGraph",
        "title": "Open Full Graph",
        "category": "Markdown Editor"
      },
      {
        "command": "vscodeMdEditor.diffWithPrevious",
        "title": "Compare with Previous Version",
        "category": "Markdown Editor"
      },
      {
        "command": "vscodeMdEditor.diffWithCommit",
        "title": "Compare with Commit...",
        "category": "Markdown Editor"
      },
      {
        "command": "vscodeMdEditor.diffWithSaved",
        "title": "Compare with Saved",
        "category": "Markdown Editor"
      }
    ],
    "configuration": {
      "title": "VS Code MD Editor",
      "properties": {
        "vscodeMdEditor.pdf.defaultZoom": {
          "type": "string",
          "enum": [
            "auto",
            "page-width",
            "page-fit",
            "actual"
          ],
          "enumDescriptions": [
            "Automatic: page width, but never larger than actual size.",
            "Fit the page width to the window.",
            "Fit the whole page in the window.",
            "Show pages at actual size (100%)."
          ],
          "default": "auto",
          "description": "Initial zoom when a PDF opens in the PDF Viewer. A zoom you set while viewing is remembered for that tab."
        },
        "vscodeMdEditor.office.sheetAppearance": {
          "type": "string",
          "enum": [
            "theme",
            "light"
          ],
          "enumDescriptions": [
            "Follow the VS Code color theme.",
            "Always show the sheet on a light background, as authored."
          ],
          "default": "theme",
          "description": "How Excel workbooks are drawn in the Excel Workbook Editor: following the VS Code theme, or always as a light sheet."
        },
        "vscodeMdEditor.office.startInEditMode": {
          "type": "boolean",
          "default": false,
          "description": "Open editable Word and Excel files with Edit already on. When off, files open in View mode and Edit (Ctrl+E) turns editing on."
        },
        "vscodeMdEditor.office.confirmStructuralEdits": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before inserting or deleting Excel rows, columns or sheets when the change cannot fully update everything that refers to them (charts, pivot tables and drawings keep their position or range). When off, those changes go ahead without the prompt. Deleting a sheet always asks."
        },
        "vscodeMdEditor.languageTool.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable LanguageTool grammar and spelling checking"
        },
        "vscodeMdEditor.languageTool.apiUrl": {
          "type": "string",
          "default": "https://api.languagetoolplus.com/v2/check",
          "description": "LanguageTool API endpoint URL. Change this for self-hosted instances."
        },
        "vscodeMdEditor.languageTool.apiKey": {
          "type": "string",
          "default": "",
          "description": "LanguageTool Premium API key (leave empty for free tier)"
        },
        "vscodeMdEditor.languageTool.username": {
          "type": "string",
          "default": "",
          "description": "LanguageTool Premium username/email (required with API key)"
        },
        "vscodeMdEditor.languageTool.language": {
          "type": "string",
          "default": "auto",
          "description": "Language code for checking (e.g., 'en-US', 'de-DE', or 'auto' for auto-detection)"
        },
        "vscodeMdEditor.languageTool.motherTongue": {
          "type": "string",
          "default": "",
          "description": "Your mother tongue language code for better error detection"
        },
        "vscodeMdEditor.languageTool.checkDelayMs": {
          "type": "number",
          "default": 1500,
          "minimum": 500,
          "maximum": 10000,
          "description": "Delay in milliseconds before triggering a grammar check after typing"
        },
        "vscodeMdEditor.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/.claude/worktrees/**"
          ],
          "description": "Glob patterns for folders the Markdown and Mermaid file lists (and the link graph) should ignore. Your files.exclude and search.exclude settings are honoured on top of these. Nested copies of a repository — such as the git worktrees Claude Code creates under .claude/worktrees — otherwise make every document appear once per copy."
        },
        "vscodeMdEditor.graph.defaultMode": {
          "type": "string",
          "enum": [
            "local",
            "global"
          ],
          "default": "local",
          "description": "Default graph view mode"
        },
        "vscodeMdEditor.graph.localDepth": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 3,
          "description": "Default BFS depth for local graph mode (1-3 hops)"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "vscodeMdEditor.openWithEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        },
        {
          "command": "vscodeMdEditor.diffWithPrevious",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "3_compare"
        },
        {
          "command": "vscodeMdEditor.diffWithCommit",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "3_compare"
        }
      ],
      "commandPalette": [
        {
          "command": "vscodeMdEditor.diffWithPrevious",
          "when": "resourceExtname == .md || resourceExtname == .markdown || editorLangId == markdown"
        },
        {
          "command": "vscodeMdEditor.diffWithCommit",
          "when": "resourceExtname == .md || resourceExtname == .markdown || editorLangId == markdown"
        },
        {
          "command": "vscodeMdEditor.diffWithSaved",
          "when": "resourceExtname == .md || resourceExtname == .markdown || editorLangId == markdown"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "copy-vendor": "node scripts/copy-vendor.js",
    "compile": "npm run check-types && npm run copy-vendor && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm run copy-vendor && node esbuild.js --watch",
    "package": "npm run check-types && npm run copy-vendor && node esbuild.js --production",
    "lint": "eslint src",
    "test": "node esbuild.js --test-bundle && node --test \"tests/**/*.test.{js,mjs}\""
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@hyzyla/pdfium": "3.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.28.0",
    "exceljs": "4.4.0",
    "saxes": "6.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@borgar/fx": "5.1.3",
    "docx-preview": "0.4.1",
    "fflate": "0.8.3",
    "force-graph": "^1.51.1",
    "jszip": "3.10.2",
    "markdown-it": "^14.3.2",
    "mermaid": "^12.1.0",
    "numfmt": "4.1.4",
    "pdfjs-dist": "6.5.438",
    "three": "^0.185.1",
    "turndown": "^7.2.2"
  }
}
